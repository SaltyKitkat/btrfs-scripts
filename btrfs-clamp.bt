#!/usr/bin/env bpftrace

// 追踪 btrfs_preempt_reclaim_metadata_space 被调用
kprobe:btrfs_preempt_reclaim_metadata_space
{
    @start[tid] = nsecs;  // 记录调用开始时间
}

kretprobe:btrfs_preempt_reclaim_metadata_space
{
    $duration_ms = (nsecs - @start[tid]) / 1000000;  // 计算耗时（毫秒）

    // 清理临时存储
    delete(@start[tid]);
    printf("%s: time=%-12llu [btrfs_preempt_reclaim]\n",
           strftime("%H:%M:%S", nsecs), $duration_ms);
}
